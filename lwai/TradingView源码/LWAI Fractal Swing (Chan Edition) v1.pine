//@version=6
// 缠论指标：包含处理 → 分型 → 笔 → 中枢 → 背驰 → 三类买卖点
// 参考开源项目：Vespa314/chan.py、waditu/czsc
// v5：预测标签改成大白话 + 字体大小、颜色可自定义
indicator("LWAI 分型波段（缠版） ",
     overlay = true,
     max_lines_count = 500,
     max_labels_count = 500,
     max_boxes_count = 500,
     max_bars_back = 5000)

// ===================== 输入参数（分组） =====================
string gCore  = "① 结构参数"
string gShow  = "② 显示开关"
string gStyle = "③ 字体和颜色"
string gPred  = "④ 下一笔预测"
string gMacd  = "⑤ MACD"
// 字体大小选项（中文，好懂）
string[] SZ = array.from("极小", "小", "中", "大", "超大")

// ---------- ① 结构参数 ----------
// 笔：顶底分型之间至少相隔几根合并K线（老笔标准=4）
minGap  = input.int(4, "笔最少间距(合并K线)",
     minval = 3,
     group = gCore)
// 中枢超过这么多笔 → 视为升级，不再产生本级别3类点
maxZsBi = input.int(9, "中枢最多笔数",
     minval = 3,
     group = gCore)
// 离开中枢那一笔力度变弱 → 不标3买/3卖
useBeiF = input.bool(true, "3类点背驰过滤", group = gCore)

// ---------- ② 显示开关 ----------
showFx   = input.bool(false, "显示分型", group = gShow)
showBi   = input.bool(true, "显示笔", group = gShow)
showZs   = input.bool(true, "显示中枢", group = gShow)
showBsp  = input.bool(true, "显示买卖点", group = gShow)
// 信号真正出现的K线打三角，并用虚线连到标签
showReal = input.bool(true, "显示真实确认时间", group = gShow)
// 底/顶分型一出现就提前提示，可能作废
showPre  = input.bool(false, "显示预备1买1卖", group = gShow)

// ---------- ③ 字体和颜色 ----------
bspSzS  = input.string("小", "买卖点字体大小",
     options = ["极小", "小", "中", "大", "超大"],
     group = gStyle)
pdSzS   = input.string("中", "预测字体大小",
     options = ["极小", "小", "中", "大", "超大"],
     group = gStyle)
fxSzS   = input.string("极小", "分型字体大小",
     options = ["极小", "小", "中", "大", "超大"],
     group = gStyle)
buyCol  = input.color(color.green, "买点底色", group = gStyle)
sellCol = input.color(color.red, "卖点底色", group = gStyle)
bspTxt  = input.color(color.white, "买卖点文字颜色", group = gStyle)
pdColor = input.color(color.fuchsia, "预测底色/线色", group = gStyle)
pdTxt   = input.color(color.white, "预测文字颜色", group = gStyle)
biColor = input.color(color.orange, "笔颜色", group = gStyle)
zsColor = input.color(color.blue, "中枢颜色", group = gStyle)

// ---------- ④ 预测 ----------
showPred = input.bool(true, "显示下一笔预测", group = gPred)
avgN     = input.int(5, "预测时长取最近几笔平均",
     minval = 1,
     group = gPred)

// ---------- ⑤ MACD ----------
fastLen = input.int(12, "MACD快线", minval = 1, group = gMacd)
slowLen = input.int(26, "MACD慢线", minval = 2, group = gMacd)
sigLen  = input.int(9, "MACD信号线", minval = 1, group = gMacd)

// ===================== 工具函数 =====================
// 中文字体选项 → Pine 的 size 常量
f_size(string s) =>
    switch s
        "极小" => size.tiny
        "小"   => size.small
        "中"   => size.normal
        "大"   => size.large
        "超大" => size.huge
        => size.small

// 价格转文字，按品种最小跳动位数显示
f_p(float v) =>
    str.tostring(v, format.mintick)

bspSize = f_size(bspSzS)
pdSize  = f_size(pdSzS)
fxSize  = f_size(fxSzS)

// ===================== MACD 面积（背驰用） =====================
[macdLine, sigLine, hist] = ta.macd(close, fastLen, slowLen, sigLen)
// 红柱面积累计、绿柱面积累计，两点相减=一笔的面积
cumPos = ta.cum(hist > 0 ? hist : 0.0)
cumNeg = ta.cum(hist < 0 ? -hist : 0.0)

// ===================== 1. K线包含处理 =====================
// 合并后K线的高、低，以及高低点所在的原始K线序号
var array<float> mH  = array.new<float>()
var array<float> mL  = array.new<float>()
var array<int>   mHB = array.new<int>()
var array<int>   mLB = array.new<int>()
// 合并K线总编号（不受数组裁剪影响）
var int mCnt = 0
// 本根K线新确认的分型（每根K线重置）
int   fxType  = 0
float fxPrice = na
int   fxBar   = na
int   fxK     = na
int n = mH.size()
if n == 0
    mH.push(high)
    mL.push(low)
    mHB.push(bar_index)
    mLB.push(bar_index)
    mCnt += 1
else
    float lh = mH.last()
    float ll = mL.last()
    bool inside = (high <= lh and low >= ll) or
         (high >= lh and low <= ll)
    if inside
        // 方向：上一根合并K线比前一根高 → 向上，取高高
        bool up = n >= 2 ? lh > mH.get(n - 2) : true
        if up
            if high > lh
                mH.set(n - 1, high)
                mHB.set(n - 1, bar_index)
            if low > ll
                mL.set(n - 1, low)
                mLB.set(n - 1, bar_index)
        else
            // 向下：取低低
            if high < lh
                mH.set(n - 1, high)
                mHB.set(n - 1, bar_index)
            if low < ll
                mL.set(n - 1, low)
                mLB.set(n - 1, bar_index)
    else
        mH.push(high)
        mL.push(low)
        mHB.push(bar_index)
        mLB.push(bar_index)
        mCnt += 1
        // 只保留最近 300 根合并K线，节省内存
        if mH.size() > 300
            mH.shift()
            mL.shift()
            mHB.shift()
            mLB.shift()
        // ===================== 2. 分型识别 =====================
        // 新K线出现，中间那根才确认分型 → 无未来函数
        int m = mH.size()
        if m >= 3
            float h1 = mH.get(m - 3)
            float h2 = mH.get(m - 2)
            float h3 = mH.get(m - 1)
            float l1 = mL.get(m - 3)
            float l2 = mL.get(m - 2)
            float l3 = mL.get(m - 1)
            if h2 > h1 and h2 > h3
                fxType  := 1
                fxPrice := h2
                fxBar   := mHB.get(m - 2)
                fxK     := mCnt - 1
            else if l2 < l1 and l2 < l3
                fxType  := -1
                fxPrice := l2
                fxBar   := mLB.get(m - 2)
                fxK     := mCnt - 1

// 分型标记（可选）
if showFx and fxType != 0
    label.new(fxBar, fxPrice, fxType == 1 ? "顶" : "底",
         style = fxType == 1 ? label.style_label_down
             : label.style_label_up,
         color = color.new(color.gray, 70),
         textcolor = bspTxt,
         size = fxSize)

// ===================== 中枢状态（提前声明，预备信号要用） =====
var bool  zsOn   = false
var float zg     = na
var float zd     = na
var float lastZG = na
var float lastZD = na

// ===================== 预备信号状态 =====================
// 预备1买的标签和价格；价格跌破 → 作废变灰
var label preBLbl = na
var float preBP   = na
var label preSLbl = na
var float preSP   = na
// 作废检查：用已发生的 low/high，无未来函数
if not na(preBP) and low < preBP
    if not na(preBLbl)
        preBLbl.set_color(color.gray)
        preBLbl.set_text("预1买✗")
    preBP := na
if not na(preSP) and high > preSP
    if not na(preSLbl)
        preSLbl.set_color(color.gray)
        preSLbl.set_text("预1卖✗")
    preSP := na

// ===================== 3. 笔 =====================
// 笔端点：价格、K线序号、类型(1顶/-1底)、合并K线编号、MACD面积累计
var array<float> bP  = array.new<float>()
var array<int>   bB  = array.new<int>()
var array<int>   bT  = array.new<int>()
var array<int>   bK  = array.new<int>()
var array<float> bCP = array.new<float>()
var array<float> bCN = array.new<float>()
var array<line>  bLines = array.new<line>()
// 本根K线是否有一笔"被确认完成"
bool newDone = false
if fxType != 0
    // 取分型所在K线的累计面积（历史值，非未来）
    int   off = bar_index - fxBar
    float cp  = cumPos[off]
    float cn  = cumNeg[off]
    int nb = bP.size()
    if nb == 0
        bP.push(fxPrice)
        bB.push(fxBar)
        bT.push(fxType)
        bK.push(fxK)
        bCP.push(cp)
        bCN.push(cn)
    else
        int   lt = bT.last()
        float lp = bP.last()
        if fxType == lt
            // 同类分型：更极端则替换（笔的延伸）
            bool better = (fxType == 1 and fxPrice > lp) or
                 (fxType == -1 and fxPrice < lp)
            if better
                bP.set(nb - 1, fxPrice)
                bB.set(nb - 1, fxBar)
                bK.set(nb - 1, fxK)
                bCP.set(nb - 1, cp)
                bCN.set(nb - 1, cn)
                if showBi and bLines.size() > 0 and nb >= 2
                    bLines.last().set_xy2(fxBar, fxPrice)
        else
            // 异类分型：间距够 且 顶高于底 → 成新笔
            bool gapOk = fxK - bK.last() >= minGap
            bool posOk = (fxType == 1 and fxPrice > lp) or
                 (fxType == -1 and fxPrice < lp)
            if gapOk and posOk
                // ---------- 预备信号（笔刚出现时判断） ----------
                float rZG = zsOn ? zg : lastZG
                float rZD = zsOn ? zd : lastZD
                if showPre and nb >= 3 and not na(rZD)
                    if fxType == -1 and fxPrice < bP.get(nb - 2)
                        // 本下跌笔面积 vs 前一下跌笔面积
                        float curA = cn - bCN.get(nb - 1)
                        float preA = bCN.get(nb - 2) -
                             bCN.get(nb - 3)
                        if fxPrice < rZD and curA < preA
                            preBLbl := label.new(fxBar, fxPrice,
                                 "预1买",
                                 style = label.style_label_up,
                                 color = color.new(buyCol, 50),
                                 textcolor = bspTxt,
                                 size = bspSize)
                            preBP := fxPrice
                    if fxType == 1 and fxPrice > bP.get(nb - 2)
                        // 本上涨笔面积 vs 前一上涨笔面积
                        float curA = cp - bCP.get(nb - 1)
                        float preA = bCP.get(nb - 2) -
                             bCP.get(nb - 3)
                        if fxPrice > rZG and curA < preA
                            preSLbl := label.new(fxBar, fxPrice,
                                 "预1卖",
                                 style = label.style_label_down,
                                 color = color.new(sellCol, 50),
                                 textcolor = bspTxt,
                                 size = bspSize)
                            preSP := fxPrice
                if showBi
                    line ln = line.new(bB.last(), lp, fxBar, fxPrice,
                         color = biColor,
                         width = 2)
                    bLines.push(ln)
                    if bLines.size() > 450
                        bLines.shift()
                bP.push(fxPrice)
                bB.push(fxBar)
                bT.push(fxType)
                bK.push(fxK)
                bCP.push(cp)
                bCN.push(cn)
                // 有3个点 → 倒数第2笔已确认，不会再变
                newDone := bP.size() >= 3

// 计算第 i 点到第 j 点这一笔的 MACD 面积
f_area(int i, int j, bool down) =>
    down ? bCN.get(j) - bCN.get(i) : bCP.get(j) - bCP.get(i)

// 取第 i 点到 i+1 点这一笔的高点、低点
f_hi(int i) =>
    math.max(bP.get(i), bP.get(i + 1))

f_lo(int i) =>
    math.min(bP.get(i), bP.get(i + 1))

// ===================== 4. 中枢 + 5. 买卖点 =====================
var box   zsBox   = na
// 当前中枢包含的笔数
var int   zsCnt   = 0
var int   zsEndPt = 0
var int   b1Pt = -1
var float b1P  = na
var int   s1Pt = -1
var float s1P  = na
bool buySig  = false
bool sellSig = false
if newDone
    int   cnt = bP.size()
    // 刚确认的笔：从点 a 到点 b
    int   a  = cnt - 3
    int   b  = cnt - 2
    float pa = bP.get(a)
    float pb = bP.get(b)
    float hi = math.max(pa, pb)
    float lo = math.min(pa, pb)
    bool  isDown = pb < pa
    // 端点 b 已固定 → 对应预备信号不再需要作废检查
    if isDown
        preBP := na
    else
        preSP := na
    // 本笔是否为 3买/3卖（在中枢判断里赋值）
    string third = ""
    // ---------- 中枢 ----------
    if zsOn
        if lo <= zg and hi >= zd
            // 与中枢重叠 → 中枢延伸，笔数+1
            zsCnt += 1
            if showZs and not na(zsBox)
                zsBox.set_right(bB.get(b))
                // 超过最多笔数 → 升级，方框变灰
                if zsCnt > maxZsBi
                    zsBox.set_bgcolor(color.new(color.gray, 85))
                    zsBox.set_border_color(color.gray)
        else
            // 这一笔完全不碰中枢 → 中枢结束
            // 过滤1：中枢已升级 → 不产生本级别3类点
            bool upgraded = zsCnt > maxZsBi
            // 过滤2：离开笔(a-1→a)比前一同向笔(a-3→a-2)力度弱
            bool weak = false
            if useBeiF and a >= 3
                bool  lDown  = not isDown
                float leaveA = f_area(a - 1, a, lDown)
                float prevA  = f_area(a - 3, a - 2, lDown)
                weak := leaveA < prevA
            if not upgraded and not weak
                if isDown and lo > zg
                    // 向下回调，最低点仍在中枢上沿之上
                    third := "3买"
                if not isDown and hi < zd
                    // 向上反抽，最高点仍在中枢下沿之下
                    third := "3卖"
            zsOn   := false
            lastZG := zg
            lastZD := zd
            // 新中枢只能用离开之后的笔，避免和老中枢共用笔
            zsEndPt := a
    else if b >= 3 and b - 3 >= zsEndPt
        // 连续三笔重叠区间：ZG=三高最低，ZD=三低最高
        float g = math.min(f_hi(b - 3),
             math.min(f_hi(b - 2), f_hi(b - 1)))
        float d = math.max(f_lo(b - 3),
             math.max(f_lo(b - 2), f_lo(b - 1)))
        if g > d
            zsOn  := true
            zg    := g
            zd    := d
            zsCnt := 3
            if showZs
                zsBox := box.new(bB.get(b - 3), zg, bB.get(b), zd,
                     border_color = zsColor,
                     bgcolor = color.new(zsColor, 85))
    // 参考中枢：当前中枢，或刚结束的中枢
    float refZG = zsOn ? zg : lastZG
    float refZD = zsOn ? zd : lastZD
    string txt = ""
    // ---------- 一类买卖点（背驰） ----------
    if b >= 3 and not na(refZD)
        float prev = bP.get(b - 2)
        if isDown and pb < refZD and pb < prev
            // 创新低但下跌面积变小 → 底背驰
            if f_area(a, b, true) < f_area(b - 3, b - 2, true)
                txt  := "1买"
                b1Pt := b
                b1P  := pb
        if not isDown and pb > refZG and pb > prev
            // 创新高但上涨面积变小 → 顶背驰
            if f_area(a, b, false) < f_area(b - 3, b - 2, false)
                txt  := "1卖"
                s1Pt := b
                s1P  := pb
    // ---------- 二类买卖点 ----------
    if txt == ""
        if isDown and b1Pt >= 0 and b == b1Pt + 2 and pb > b1P
            txt := "2买"
        if not isDown and s1Pt >= 0 and b == s1Pt + 2 and pb < s1P
            txt := "2卖"
    // ---------- 三类买卖点 ----------
    if txt == ""
        txt := third
    else if third != ""
        // 二买和三买同时出现 → 合并显示，如 "2买+3买"
        txt := txt + "+" + third
    if txt != ""
        bool isBuy = str.contains(txt, "买")
        buySig  := isBuy
        sellSig := not isBuy
        color sc = isBuy ? buyCol : sellCol
        if showBsp
            label.new(bB.get(b), pb, txt,
                 style = isBuy ? label.style_label_up
                     : label.style_label_down,
                 color = sc,
                 textcolor = bspTxt,
                 size = bspSize)
        // 真实确认时间：虚线从买卖点连到当前K线
        if showReal
            line.new(bB.get(b), pb, bar_index, pb,
                 color = sc,
                 style = line.style_dashed,
                 width = 1)

// 真实确认K线上的小三角（实盘这一根才能操作）
plotshape(showReal and buySig, "买点确认", shape.triangleup,
     location.belowbar, buyCol, size = size.tiny)
plotshape(showReal and sellSig, "卖点确认", shape.triangledown,
     location.abovebar, sellCol, size = size.tiny)

// ===================== 7. 下一笔预测 =====================
// 只在最后一根K线画，不参与信号 → 不影响回测
var line  pdLine = na
var line  pdL1   = na
var line  pdL2   = na
var line  pdL3   = na
var line  pdInv  = na
var label pdLbl  = na
if showPred and barstate.islast
    // 先删掉旧的预测图形（na 时跳过）
    if not na(pdLine)
        pdLine.delete()
    if not na(pdL1)
        pdL1.delete()
    if not na(pdL2)
        pdL2.delete()
    if not na(pdL3)
        pdL3.delete()
    if not na(pdInv)
        pdInv.delete()
    if not na(pdLbl)
        pdLbl.delete()
    int nb = bP.size()
    if nb >= 3
        float sp = bP.last()
        int   sb = bB.last()
        // 最后确认点是底 → 下一笔向上(+1)，是顶 → 向下(-1)
        int dir = bT.last() == -1 ? 1 : -1
        // 前一同向笔：点 nb-3 → nb-2
        float sameLen = math.abs(bP.get(nb - 2) - bP.get(nb - 3))
        float t1 = sp + dir * sameLen * 0.618
        float t2 = sp + dir * sameLen
        float t3 = sp + dir * sameLen * 1.618
        // 最近几笔平均K线数，估计这一笔的时长
        int k = math.min(avgN, nb - 1)
        float sumBars = 0.0
        for i = 1 to k
            sumBars += bB.get(nb - i) - bB.get(nb - i - 1)
        int dur = math.max(int(math.round(sumBars / k)), minGap + 1)
        // 预测终点K线：太近就往后放，最远不超过未来 490 根
        int ex = math.max(sb + dur, bar_index + 3)
        ex := math.min(ex, bar_index + 490)
        // 中枢目标：向上看上沿，向下看下沿（要在前进方向上）
        float zsT = na
        if zsOn
            float zt = dir == 1 ? zg : zd
            if (dir == 1 and zt > sp) or (dir == -1 and zt < sp)
                zsT := zt
        // 主预测线：出发点 → 目标2
        pdLine := line.new(sb, sp, ex, t2,
             color = pdColor,
             style = line.style_dashed,
             width = 2)
        // 三条目标水平线
        pdL1 := line.new(bar_index, t1, ex, t1,
             color = color.new(pdColor, 50),
             style = line.style_dotted)
        pdL2 := line.new(bar_index, t2, ex, t2,
             color = pdColor,
             style = line.style_dotted)
        pdL3 := line.new(bar_index, t3, ex, t3,
             color = color.new(pdColor, 50),
             style = line.style_dotted)
        // 作废线：反方向破了出发点，预测作废
        pdInv := line.new(sb, sp, ex, sp,
             color = color.gray,
             style = line.style_dashed)
        // ---------- 大白话标签 ----------
        string upDn   = dir == 1 ? "涨 ↑" : "跌 ↓"
        string zsName = dir == 1 ? "压力(箱子上沿)" : "支撑(箱子下沿)"
        string invNm  = dir == 1 ? "跌破就作废" : "涨破就作废"
        string tx = "下一笔：" + upDn
        tx += "\n目标1 弱: " + f_p(t1)
        tx += "\n目标2 中: " + f_p(t2)
        tx += "\n目标3 强: " + f_p(t3)
        if not na(zsT)
            tx += "\n" + zsName + ": " + f_p(zsT)
        tx += "\n" + invNm + ": " + f_p(sp)
        tx += "\n大约走 " + str.tostring(dur) + " 根K线"
        pdLbl := label.new(ex, t2, tx,
             style = dir == 1 ? label.style_label_down
                 : label.style_label_up,
             color = color.new(pdColor, 20),
             textcolor = pdTxt,
             size = pdSize,
             textalign = text.align_left)

// ===================== 6. 报警 =====================
alertcondition(buySig, "缠论买点", "缠论出现买点(1/2/3买)")
